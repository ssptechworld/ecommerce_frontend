# ===================================================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development.
# ===================================================================

# Backend API Base URL
# Local development:
VITE_API_URL=http://localhost:5001/api
# Production (set in Vercel or .env.production):
# VITE_API_URL=https://ecommerce-backend-y2b5.onrender.com/api

# Razorpay Public Key ID (Required for frontend payment checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
